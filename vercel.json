{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/scheduler/trigger/sched_spark_ai_hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/scheduler/trigger/sched_gold_hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/scheduler/trigger/sched_global_hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/scheduler/trigger/sched_spark_ai_daily",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/scheduler/trigger/sched_spark_ai_intel",
      "schedule": "30 16 * * *"
    }
  ]
}
